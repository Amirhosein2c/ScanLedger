# App URL used by server-side gateway construction (optional)
NEXT_PUBLIC_APP_URL=

# Public path prefix for API proxy (default: /api)
NEXT_PUBLIC_API_PATH=/api

# Upstream API gateway base URL for server-side forwarding (required for non-mock mode)
# Replace with your trusted API host (must be HTTPS)
NEXT_PUBLIC_BASE_URL=https://your-api-host.example.com

# Optional internal origin overrides for server-side requests
API_GATEWAY_INTERNAL_ORIGIN=

# Optional default header value for gateway requests
GD_HEADER_VALUE=

# Admin auth token secret (if required by backend)
SERVER_SECRET=

# Google OAuth configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_SCOPES=
